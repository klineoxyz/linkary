# Worker (run:jobs, sync:x:tweets:daily, x:provider:selftest). Set in Railway Variables for prod.
# For local runs, scripts load apps/web/.env.local first — put Supabase + Twitter API keys there.
# Twitter API key: any one of TWITTERAPI_API_KEY, TWITTERAPI_IO_KEY, TWITTERAPI_KEY, TWITTERAPI_TOKEN (first found wins).

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TWITTERAPI_API_KEY=your-twitterapi-key
