# Same Supabase project as Linkary. CRM uses crm_* tables only.
# Copy these from apps/web/.env.local if needed. Next only loads apps/crm/.env.local (not the monorepo root).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for local dev + magic-link redirects. Must match the origin you open in the browser.
# Local: http://localhost:3002  |  Production: https://crm.linkary.xyz
NEXT_PUBLIC_APP_URL=http://localhost:3002

# --- Playwright: authenticated /campaigns/[id]/report QA (optional; never commit secrets) ---
# Use a Supabase user that exists in the same project and has Email + password sign-in enabled.
# You may reuse the same variables as apps/web E2E: E2E_TEST_USER_EMAIL / E2E_TEST_USER_PASSWORD
# (global setup loads apps/crm/.env.local then apps/web/.env.local).
# E2E_CRM_TEST_USER_EMAIL=
# E2E_CRM_TEST_USER_PASSWORD=
#
# Optional: three different campaign UUIDs for scenario coverage (defaults to QA seed id below).
# CRM_E2E_CAMPAIGN_PROMOTED_SNAPSHOTS=00000000-0000-4000-8000-00000000ca01
# CRM_E2E_CAMPAIGN_SPARSE=
# CRM_E2E_CAMPAIGN_PROOFS=
#
# Optional destructive test: submits snapshot form (off by default).
# CRM_E2E_SNAPSHOT_SUBMIT=1
#
# Staging / custom host:
# PLAYWRIGHT_CRM_BASE_URL=https://your-crm-host
# PLAYWRIGHT_NO_WEB_SERVER=1   # if CRM is already running

# Production: share auth with linkary.xyz. Set to .linkary.xyz in both Vercel projects. Leave unset for local.
# NEXT_PUBLIC_COOKIE_DOMAIN=.linkary.xyz

# Optional: for Linkary→CRM sync API (server-side only). See docs/LINKARY_CRM_SYNC.md.
# CRM_SYNC_SECRET=shared-secret-with-apps-web
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: enable server-side X handle verification in Campaign definition form
# (promoted_org_id accepts @handle / x.com/handle and validates against twitterapi.io).
# TWITTERAPI_API_KEY=your-twitterapi-key
