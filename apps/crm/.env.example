# Same Supabase project as Linkary. CRM uses crm_* tables only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical app URL (e.g. https://crm.linkary.xyz). Used for auth redirects. Local: http://localhost:3002
# NEXT_PUBLIC_APP_URL=http://localhost:3002

# Production: share auth with linkary.xyz. Set to .linkary.xyz in both Vercel projects. Leave unset for local.
# NEXT_PUBLIC_COOKIE_DOMAIN=.linkary.xyz

# Optional: for server-side sync or admin (do not expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
