{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:network": "next dev --hostname 0.0.0.0",
    "dev:webpack": "next dev --webpack",
    "dev:3001": "next dev --port 3001",
    "dev:minimal-server": "node scripts/minimal-server.js",
    "prebuild": "pnpm --filter @linkary/plan-key run build",
    "build": "next build",
    "db:push": "pnpm -w run db:push",
    "start": "next start",
    "lint": "eslint",
    "check:storage-url": "pnpm exec tsx src/lib/isPrivateStorageUrl.checks.ts",
    "check:reserved": "pnpm exec tsx scripts/assertReservedPaths.ts",
    "check:reserved-collisions": "pnpm exec tsx scripts/checkReservedCollisions.ts",
    "verify:slug-routing-live": "tsx scripts/verifySlugRoutingLive.ts",
    "launch:check": "tsx scripts/launchCheck.ts",
    "verify:rls": "tsx scripts/verifyRlsSafety.ts",
    "test:xspaces": "tsx scripts/xspaces-regression.ts",
    "test:xspaces-dates": "tsx src/figma/app/components/xspaces/utils.test.ts",
    "test:profile-analytics": "tsx src/lib/crossUserAnalyticsAllowlist.test.ts && tsx src/lib/profileRedirect.test.ts && tsx src/lib/appRouting.test.ts && tsx src/lib/reviewsContract.test.ts",
    "test:route": "vitest run",
    "test:route:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "smoke:xspaces": "tsx scripts/xspaces-smoke.ts",
    "smoke:xspaces:full": "pnpm build && pnpm run smoke:xspaces",
    "release:gate": "pnpm run build && pnpm test:route && pnpm run test:profile-analytics"
  },
  "dependencies": {
    "@linkary/plan-key": "workspace:*",
    "@coinbase/cdp-core": "^0.0.85",
    "@coinbase/cdp-hooks": "^0.0.85",
    "@coinbase/cdp-react": "^0.0.85",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.96.0",
    "@types/react-helmet": "^6.1.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "html-to-image": "^1.11.13",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.570.0",
    "motion": "^12.34.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-day-picker": "^9.13.2",
    "react-dom": "19.2.3",
    "react-force-graph-2d": "^1.29.1",
    "react-helmet": "^6.1.0",
    "react-hook-form": "^7.71.1",
    "react-resizable-panels": "^4.6.4",
    "recharts": "^3.7.0",
    "resend": "^6.9.2",
    "sonner": "^2.0.7",
    "swr": "^2.4.0",
    "tailwind-merge": "^3.4.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "web-vitals": "^5.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
