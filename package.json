{
  "name": "linkary",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "backfill-rep": "pnpm exec tsx scripts/backfillRep.ts",
    "diagnose-engagement": "pnpm exec tsx apps/web/scripts/diagnoseEngagementSources.ts",
    "backfill-engagement": "pnpm exec tsx apps/web/scripts/backfillAvgEngagementPerPost.ts",
    "qa:rep": "pnpm exec tsx apps/web/scripts/qaRep.ts",
    "launch:check": "pnpm --filter web run launch:check",
    "verify:rls": "pnpm --filter web run verify:rls",
    "dev": "pnpm --filter web dev",
    "db:push": "npx supabase db push",
    "deploy:auth": "npx supabase functions deploy auth-cdp-login --no-verify-jwt",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter linkary-api dev",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter linkary-api build",
    "sync:x:tweets:daily": "pnpm --filter worker run sync:x:tweets:daily",
    "sync:x:profiles:daily": "pnpm --filter worker run sync:x:profiles:daily",
    "run:jobs": "pnpm --filter worker run run:jobs",
    "x:provider:selftest": "pnpm --filter worker run x:provider:selftest",
    "check:storage-url": "pnpm --filter web run check:storage-url",
    "start": "node apps/api/dist/index.js"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.2"
  }
}
