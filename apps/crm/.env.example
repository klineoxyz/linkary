# Same Supabase project as Linkary. CRM uses crm_* tables only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Production: share auth with linkary.xyz so users logged in there can access CRM without signing in again.
# Set to .linkary.xyz in both Vercel projects (web + CRM). Leave unset for local dev.
# NEXT_PUBLIC_COOKIE_DOMAIN=.linkary.xyz

# Optional: for server-side sync or admin (do not expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
